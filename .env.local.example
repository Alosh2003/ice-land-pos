# ICE LAND local backend environment
# Copy this file to .env.local and fill in the values from `supabase start`.
# Never commit .env.local — it contains local secrets.

# Local Supabase API URL (PostgREST + Auth + Storage)
VITE_SUPABASE_URL="http://127.0.0.1:54321"
SUPABASE_URL="http://127.0.0.1:54321"

# Public anon key — safe to ship in browser code
VITE_SUPABASE_PUBLISHABLE_KEY="REPLACE_WITH_ANON_KEY"
SUPABASE_PUBLISHABLE_KEY="REPLACE_WITH_ANON_KEY"

# Service role key — server-side only, bypasses RLS. NEVER expose to browser.
SUPABASE_SERVICE_ROLE_KEY="REPLACE_WITH_SERVICE_ROLE_KEY"

# Optional: override Lovable production URL
# LOVABLE_API_KEY=  # keep out of browser code
